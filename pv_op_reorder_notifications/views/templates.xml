<odoo>
  <!-- QWeb template used by the OWL systray component -->
  <template id="reorder_bell_template" name="Reorder Bell Template">
    <t t-name="op_reorder_notifications.ReorderBell">
      <div class="o_systray_item dropdown" t-attf-class="{{ state.open ? 'show' : '' }}">
        <a href="#" class="dropdown-toggle" role="button" t-on-click="onClickBell" aria-expanded="false">
          <i class="fa fa-bell"/>
          <t t-if="state.count">
            <span class="badge rounded-pill bg-danger o_systrayCounter">
              <t t-esc="state.count"/>
            </span>
          </t>
        </a>
        <div class="dropdown-menu dropdown-menu-end" t-attf-class="{{ state.open ? 'show' : '' }}" style="min-width: 420px;">
          <div class="dropdown-header d-flex justify-content-between align-items-center">
            <span>Reorder Notifications</span>
            <a href="#" class="text-decoration-none" t-on-click.stop.prevent="onMarkAll">Mark all as read</a>
          </div>
          <div class="dropdown-divider"/>
          <t t-if="state.items.length">
            <t t-foreach="state.items" t-as="it" t-key="it.id">
              <a class="dropdown-item d-flex justify-content-between align-items-center"
                 href="#" t-on-click.stop.prevent="() => onOpenItem(it)">
                <span class="text-truncate"><t t-esc="it.name"/></span>
                <t t-if="!it.opened"><span class="badge bg-primary">new</span></t>
              </a>
            </t>
            <div class="dropdown-divider"/>
            <a class="dropdown-item text-center" href="#" t-on-click.stop.prevent="onOpenList">View all</a>
          </t>
          <t t-else="">
            <div class="dropdown-item text-muted">No notifications</div>
          </t>
        </div>
      </div>
    </t>
  </template>
</odoo>
